{
    "name": "portfolio-piscine",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .build-server && node scripts/prerender.mjs && node scripts/build-cv.mjs",
        "preview": "vite preview",
        "test": "vitest run --project unit",
        "test:cv": "vitest run --project cv",
        "test:dist": "vitest run --project dist --passWithNoTests",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource/funnel-display": "^5.3.0",
        "@fontsource/noto-sans-sc": "^5.3.1",
        "@fontsource/nunito": "^5.3.0",
        "@fontsource/zen-maru-gothic": "^5.3.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "simple-icons": "^16.36.0",
        "three": "^0.187.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/pdfkit": "^0.17.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.187.0",
        "@vitejs/plugin-react": "^6.2.1",
        "jsdom": "^29.1.1",
        "pdfkit": "^0.20.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
}
